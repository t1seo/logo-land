  "brief": {
    "name": "OFFCUT",
    "exact_text": "OFFCUT",
    "product": "A fictional furniture studio making repairable modular shelves from reclaimed wood offcuts.",
    "audience": "Design-conscious city renters who want durable furniture that fits small homes and can move with them.",
    "personality": "Resourceful, warm, precise, quietly witty and unpretentious.",
    "use_case": "A clean ecommerce header and a simple shipping stamp; compare the complete identity at 192 pixels wide.",
    "display_width": 192,
    "logo_type": "combination",
    "mode": "brand",
    "background": "opaque",
    "count": 3,
    "colors": [
      "#23483E",
      "#D97446"
    ],
    "notes": "Use dark forest ink as the structural color and optional restrained clay orange as an accent. Pure white background. Develop three genuinely different construction ideas inspired by useful offcuts, joinery or modular fit. Avoid stock chairs, leaves, trees, recycling arrows, generic initials inside circles, and staged mockups. Give OFFCUT clear deliberate letter spacing; the symbol should have one memorable gesture and survive reduction. Each candidate is one standalone original image, not a comparison grid. Colors are advisory. This is a demonstration brand, not a claim of legal uniqueness.",
    "color_policy": "advisory"
  },
  "planning": {
    "role": "strategy_and_art_direction",
    "provider": "openai-codex",
    "model": "gpt-5.6-sol"
  },
  "directions": [
    {
      "id": "useful-remainder",
      "title": "Useful Remainder",
      "motif": "A low rectangular offcut loses a substantial corner, and that same displaced piece reappears across a white gap as a small supporting foot. The single witty gesture turns an apparent remainder into a useful structural part without depicting furniture literally.",
      "rationale": "The audience wants compact furniture that feels durable rather than temporary. A missing piece made structurally useful proposes resourcefulness through one immediately visible relationship. The low silhouette supports an orderly ecommerce header, while the reusable wedge introduces warmth and quiet wit without becoming an environmental badge.",
      "risk": "The wedge could read as a drop shadow, loose scrap or play-button shape if it is too small, too close or incorrectly aligned. Keep a clear white separation, make the wedge contour correspond visibly to the removed corner, and place it on a believable support line. At a complete-mark width of 192 pixels, enlarge the cut and wedge if either relationship becomes ambiguous; do not use shading to rescue it."
    },
    {
      "id": "repair-scarf-joint",
      "title": "Repair Joint",
      "motif": "Two unequal upright slabs meet through a broad stepped scarf joint. A continuous white channel reveals how the pieces connect, while a restrained clay insert marks repair as deliberate construction rather than damage.",
      "rationale": "A visible repair joint translates durability and future maintenance into precise maker language. The unequal slabs suggest that different available pieces can become interdependent, while the exposed channel makes the assembly logic legible. Its upright silhouette differs clearly from the low remainder mark and can act as a compact shipping stamp.",
      "risk": "At small size, the stepped channel may close and turn the slabs into an undifferentiated block, while the orange key may resemble a decorative pixel. Limit the joint to two broad steps, keep its white channel wider than incidental letter gaps, and remove the key rather than shrinking it below recognition. Verify that the construction does not resemble an H, chain link or generic monogram at 192 pixels."
    },
    {
      "id": "modular-shift",
      "title": "Modular Shift",
      "motif": "Three short shelf-like modules follow a staggered upward rhythm, but the center module passes through a square notch in the upper module. The precise overlap communicates rearrangement and compact fit, while softly rounded outer terminals make the system feel domestic rather than industrial.",
      "rationale": "Renters need furniture that can rearrange and move with them. A shifting three-part rhythm proposes adaptability, while the single pass-through notch demonstrates real fit rather than a generic stack. The rising silhouette adds energy and differs from both the solid offcut and upright repair-joint constructions.",
      "risk": "Three bars can easily become a menu icon, signal-strength graphic, staircase or literal shelf. The unequal lengths, one unmistakable square pass-through notch and contrasting terminal treatment must carry the distinction. At 192 pixels, the white reveals may vanish or the orange module may appear merely overlaid; widen the notch clearance and reduce the stagger before adding detail."
    }
  ],
