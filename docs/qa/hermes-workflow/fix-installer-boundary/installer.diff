+def _restore_previous(backup: Path, target: Path, error: OSError | KeyboardInterrupt) -> None:
+    try:
+        if backup.exists() and not (target.exists() or target.is_symlink()):
+            _ = backup.rename(target)
+    except (OSError, KeyboardInterrupt) as restore_error:
+        error.add_note(f"Installation restoration failed: {restore_error!r}")
+    if backup.exists():
+        error.add_note(f"Previous installation retained at {backup}")
+
+
+def _discard_stage(path: Path, error: OSError | KeyboardInterrupt | None) -> None:
+    try:
+        if path.exists():
+            shutil.rmtree(path)
+    except (OSError, KeyboardInterrupt) as cleanup_error:
+        if error is None:
+            raise
+        error.add_note(f"Installation cleanup failed at {path}: {cleanup_error!r}")
